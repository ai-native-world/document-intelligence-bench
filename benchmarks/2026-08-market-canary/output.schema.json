{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["fields", "evidence", "uncertainties"],
  "properties": {
    "fields": {
      "type": "object",
      "properties": {
        "order": {
          "type": "object",
          "properties": {
            "product_model": {"type": "string"},
            "quantity": {"type": "integer"},
            "total_price_cny": {"type": "number"},
            "delivery_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
          },
          "additionalProperties": false
        },
        "inspection": {
          "type": "object",
          "properties": {
            "batch_id": {"type": "string"},
            "defect_rate": {"type": "number"},
            "result": {"type": "string"},
            "exception_owner": {"type": "string"},
            "sla_hours": {"type": "integer"}
          },
          "additionalProperties": false
        },
        "sales": {
          "type": "object",
          "properties": {
            "top_region": {"type": "string"},
            "top_value": {"type": "number"},
            "total_value": {"type": "number"}
          },
          "additionalProperties": false
        },
        "process": {
          "type": "object",
          "properties": {
            "exception_trigger": {"type": "string"},
            "exception_owner": {"type": "string"},
            "sla_hours": {"type": "integer"},
            "normal_output": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fact_id", "source_ref", "quote"],
        "properties": {
          "fact_id": {"type": "string"},
          "source_ref": {"type": "string"},
          "quote": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fact_id", "reason"],
        "properties": {
          "fact_id": {"type": "string"},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
