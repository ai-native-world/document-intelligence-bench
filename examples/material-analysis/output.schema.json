{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["fields", "evidence", "uncertainties"],
  "properties": {
    "fields": { "type": "object" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fact_id", "source_ref", "quote"],
        "properties": {
          "fact_id": { "type": "string" },
          "source_ref": { "type": "string" },
          "quote": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fact_id", "reason"],
        "properties": {
          "fact_id": { "type": "string" },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
